# trocar profiling image with the LATEST Nsight Systems.
# The base (trocar-rlinf-prof, via the CUDA toolkit) ships nsys 2024.6.2, whose
# reports a 2024.4 host GUI cannot open and which lacks newer graphics-trace
# fixes. Install nsight-systems-2026.1.3 from the CUDA apt repo (already
# configured in the base) and put it first on PATH so RLinf's `nsys` (bare name)
# resolves to it.
#
# Build: DOCKER_BUILDKIT=0 docker build -f docker/Dockerfile.trocar-prof-nsys \
#          -t trocar-rlinf-prof-nsys:latest .
FROM trocar-rlinf-prof:latest

ARG NSYS_PKG=nsight-systems-2026.1.3
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${NSYS_PKG}" && \
    rm -rf /var/lib/apt/lists/* && \
    NSYS_BIN="$(ls /opt/nvidia/nsight-systems/*/target-linux-x64/nsys | sort -V | tail -1)" && \
    ln -sf "$NSYS_BIN" /usr/local/bin/nsys && \
    echo "installed nsys -> $NSYS_BIN"

RUN nsys --version
